# =============================================================================
# Telegram Monitoring Agent Configuration
# =============================================================================

# Telegram Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
MONITORED_CHATS=-1001234567890,-1001234567891
MESSAGE_COLLECTION_INTERVAL=300
MAX_MESSAGES_PER_FETCH=100

# Yandex Wiki Configuration
YANDEX_TOKEN=your_yandex_token_here
YANDEX_ORGANIZATION_ID=your_organization_id_here
WIKI_MCP_URL=http://127.0.0.1:8080
WIKI_BASE_FOLDER=telegram_report

# Yandex GPT Configuration
YANDEX_API_KEY=your_yandex_api_key_here
YANDEX_FOLDER_ID=your_yandex_folder_id_here
YANDEX_MODEL_ID=yandexgpt-lite
YANDEX_GPT_URL=https://llm.api.cloud.yandex.net/foundationModels/v1/completion
YANDEX_GPT_TEMPERATURE=0.3
YANDEX_GPT_MAX_TOKENS=4000

# Database Configuration
DB_PATH=telegram_messages.db
# DATABASE_URL=sqlite:///telegram_messages.db

# Scheduler Configuration
DAILY_SUMMARY_TIME=21:00
TIMEZONE=Europe/Moscow

# Application Configuration
LOG_LEVEL=INFO
LOG_FILE=logs/telegram_monitor.log
TEMP_DIR=./temp
DEBUG=false

# =============================================================================
# Инструкции по получению токенов и настроек
# =============================================================================

# 1. Telegram Bot Token:
#    - Создайте бота через @BotFather в Telegram
#    - Получите токен и добавьте его в TELEGRAM_BOT_TOKEN
#
# 2. Monitored Chats:
#    - Добавьте ID чатов для мониторинга через запятую
#    - Для групп: используйте отрицательные ID (например, -1001234567890)
#    - Для приватных чатов: получите ID через бота @userinfobot
#
# 3. Yandex Wiki Token:
#    - Получите IAM токен: yc iam create-token
#    - Или создайте OAuth приложение на https://oauth.yandex.ru/client/new
#
# 4. Yandex Organization ID:
#    - Найдите в URL Yandex Wiki или через API Yandex Cloud
#
# 5. Yandex GPT API Key:
#    - Создайте сервисный аккаунт в Yandex Cloud
#    - Получите API ключ через консоль или CLI: yc iam api-key create
#
# 6. Yandex Folder ID:
#    - ID каталога Yandex Cloud (например, b1g8v1234567890abcdef)
#
# 7. Wiki MCP Server:
#    - Убедитесь, что Wiki MCP сервер запущен по указанному URL
#    - По умолчанию: http://127.0.0.1:8080
#
# 8. Daily Summary Time:
#    - Время в формате HH:MM (24-часовой формат)
#    - По умолчанию: 21:00 (9 вечера по указанному часовому поясу)