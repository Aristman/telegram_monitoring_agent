# Yandex Wiki MCP Server Configuration

# OAuth или IAM токен для доступа к Yandex API
# Получить через: yc iam create-token
# Или через OAuth приложение Yandex
YANDEX_TOKEN=your_yandex_token_here

# ID вашей организации Yandex 360
# Можно найти в URL Yandex Wiki или через API
YANDEX_ORGANIZATION_ID=your_organization_id_here

# Базовый URL API Yandex Wiki (обычно не требует изменения)
WIKI_API_URL=https://wiki.yandex.ru/api/v1

# Настройки сервера
HOST=127.0.0.1
PORT=8080